# Copy to .env (gitignored) and fill in. Any provider without a key is skipped.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=
# OpenAI-compatible endpoints (e.g. Groq) can be used via OPENAI_BASE_URL
OPENAI_BASE_URL=

# Which provider the pipeline uses by default: gemini | anthropic | openai | offline
LLM_PROVIDER=offline
LLM_MAX_CALLS=2000
LLM_MAX_COST_USD=10.0
LLM_MIN_INTERVAL_S=4.5
LLM_CACHE_DIR=.cache/llm

DATABASE_URL=sqlite:///./codemigrate.db
JWT_SECRET=change-me
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
SEED=42
